  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "admin": "tsx server/admin.ts",
    "restore": "tsx scripts/restore.ts",
    "test:browser": "playwright test",
